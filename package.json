{
  "name": "dsh-timer-scheduler-ui",
  "version": "0.2.2",
  "description": "DSH plugin: an agent self-scheduler that wakes the agent later to check on background/remote work, plus a header reminder menu in the web UI.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "test",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "PROFILE_EVIDENCE.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-client",
    "timer",
    "reminder",
    "scheduler",
    "agent",
    "ui"
  ],
  "author": "GMH13552",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMH13552/dsh-timer-scheduler.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web",
      "immediately": true
    },
    "compatibility": {
      "dshReleases": {
        "0.1.0-rc.8": "compatible",
        "0.1.1-rc.1": "compatible",
        "0.1.1-rc.2": "compatible",
        "0.1.5-rc.1": "compatible"
      },
      "dsh": ">=0.1.0-rc.8 <0.2.0",
      "node": ">=20"
    },
    "entryIds": [
      "timer-scheduler-ui"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/delivery.mjs && node test/client.mjs",
    "sync:profile": "node scripts/sync-profile.mjs"
  }
}
